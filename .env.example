# Copy to .env.local for local development. Never commit the real .env* files.

# --- Database (Phase 3) ---
# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL="postgresql://user:password@localhost:5432/trends"

# --- Auth (Phase 6) ---
# Secret used to sign/encrypt session data. Generate a long random value,
# e.g. `openssl rand -base64 32`. Never reuse across environments.
AUTH_SECRET=""

# --- Object storage / CDN (Phase 3+) ---
# Populated once product media storage is introduced.
STORAGE_BUCKET_URL=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Payment provider (Phase 9) ---
# Left blank until a real Iranian payment gateway is configured. The
# checkout/payment code must treat this as "not configured" rather than
# fabricating credentials — see CLAUDE_BUILD_INSTRUCTIONS.txt rule A.17.
PAYMENT_PROVIDER=""
PAYMENT_MERCHANT_ID=""

# --- SMS/OTP provider (Phase 6+) ---
SMS_PROVIDER_API_KEY=""

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
